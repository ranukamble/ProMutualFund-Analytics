# ==============================================================================
# ProMutualFund Analytics - Environment Configuration
# ==============================================================================

# --- 1. Automated Daily AMFI Background Sync ---
# Auto-sync latest NAVs daily at 9:00 PM IST when AMFI releases official daily Net Asset Values
ENABLE_BACKGROUND_SYNC=true
AMFI_SYNC_HOUR_IST=21
AMFI_SYNC_MINUTE_IST=0
AMFI_DATA_URL=https://www.amfiindia.com/spages/NAVAll.txt

# --- 2. Server & Security ---
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=pro-mutualfund-secret-key-change-in-production
API_KEY=POWER_BI_KEY_2026

# --- 3. AI Intelligence (Aria Copilot) ---
# Cohere Command R+ API Key (optional - built-in smart advisor runs if empty)
COHERE_API_KEY=QH83cgxe0makcsUhQXdrabIDkC7t0IWvjPMYsrFD
GROQ_API_KEY=
OPENAI_API_KEY=

# --- 4. Caching & Performance ---
# Options: SimpleCache | RedisCache
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=86400

# --- 5. Market Feeds & Notifications (Optional) ---
MMI_REFRESH_INTERVAL=300
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
